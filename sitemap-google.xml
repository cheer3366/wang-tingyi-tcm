---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://cheer3366.github.io/wang-tingyi-tcm/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  <url><loc>https://cheer3366.github.io/wang-tingyi-tcm/articles/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  {% assign health_articles = site.pages | where: "layout", "article" | where: "published", true %}
  {% for article in health_articles %}<url><loc>{{ site.url }}{{ site.baseurl }}{{ article.url }}</loc><lastmod>{{ article.date_modified | date: "%Y-%m-%d" }}</lastmod></url>{% endfor %}
  {% for service in site.pages %}{% if service.url contains '/services/' and service.url contains '.html' %}<url><loc>{{ site.url }}{{ site.baseurl }}{{ service.url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>{% endif %}{% endfor %}
</urlset>
